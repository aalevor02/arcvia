---
import brand from '@arcvia/brand'
import AccountMenu from './AccountMenu.tsx'

const nav = [
  { label: 'How it works', href: '/#how-it-works' },
  { label: 'Services', href: '/services/' },
  { label: 'Pricing', href: '/pricing/' },
  { label: 'Enterprise', href: '/enterprise/' },
  { label: 'Referral', href: '/referral/' },
]

const currentPath = Astro.url.pathname
const isCurrent = (href: string) => !href.includes('#') && currentPath === href
---

<header
  class="sticky top-0 z-40 border-b border-line/70 bg-surface/85 backdrop-blur-md"
>
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
      <span
        class="grid h-8 w-8 place-items-center rounded-lg bg-accent text-sm font-bold text-white"
        aria-hidden="true">{brand.name.charAt(0)}</span
      >
      <span>{brand.name}</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-7 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={[
              'text-sm transition-colors',
              isCurrent(item.href)
                ? 'font-medium text-ink'
                : 'text-ink-soft hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact/"
        class="hidden text-sm text-ink-soft transition-colors hover:text-ink xl:inline-flex"
        >Book a demo</a
      >

      <!-- Space reserved so the header does not reflow when the island mounts.
           min-w matches the widest signed-out state; see AccountMenu.tsx for
           why this is client:only rather than server-rendered. -->
      <div class="flex min-h-9 min-w-[9.5rem] items-center justify-end">
        <AccountMenu client:only="react" />

        <!-- The island is the only thing that can know whether someone is
             signed in, and it needs JavaScript to find out. Without this
             fallback, a visitor with JS disabled gets no route to sign in at
             all — the header simply renders an empty gap. -->
        <noscript>
          <span class="flex items-center gap-3">
            <a href="/login/" class="text-sm font-medium">Sign in</a>
            <a href="/register/" class="btn-primary !px-4 !py-2"
              >Get started free</a
            >
          </span>
        </noscript>
      </div>

      <button
        type="button"
        id="nav-toggle"
        class="grid h-9 w-9 place-items-center rounded-lg border border-line lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-line bg-surface lg:hidden">
    <nav aria-label="Mobile" class="shell flex flex-col py-3">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={[
              'py-2.5 text-sm',
              isCurrent(item.href)
                ? 'font-medium text-ink'
                : 'text-ink-soft hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/login/" class="py-2.5 text-sm font-medium text-ink">Sign in</a>
      <a href="/register/" class="py-2.5 text-sm font-medium text-accent"
        >Create account</a
      >
      <a href="/contact/" class="py-2.5 text-sm text-ink-soft hover:text-ink"
        >Book a demo</a
      >
    </nav>
  </div>
</header>

<script>
  // Plain DOM, no framework. A hamburger toggle does not justify shipping a
  // component runtime to every visitor.
  const toggle = document.getElementById('nav-toggle')
  const panel = document.getElementById('mobile-nav')

  const closeMenu = (returnFocus = false) => {
    panel?.classList.add('hidden')
    toggle?.setAttribute('aria-expanded', 'false')
    toggle?.setAttribute('aria-label', 'Open menu')
    if (returnFocus && toggle instanceof HTMLElement) toggle.focus()
  }

  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden') === false
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
  })

  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => closeMenu())
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && panel?.classList.contains('hidden') === false) {
      closeMenu(true)
    }
  })
</script>
