---
import brand from '@arcvia/brand'

/**
 * The published walkthrough — what a client actually opens.
 *
 * ── Why this page is the product ────────────────────────────────────────────
 * Everything upstream of here is a tool for making this page. A buyer never
 * sees the plan editor, the catalogue or the bake queue; they get a link, and
 * this is what is behind it. If this page is not convincing, none of the rest
 * counts.
 *
 * ── Why it is static ────────────────────────────────────────────────────────
 * The site builds to plain HTML with no Node process in production, which is
 * what makes hosting cost pennies. A slug cannot be prerendered — scenes are
 * published after the build — so the slug is read from the path at runtime and
 * the scene fetched from the API. One HTML file serves every walkthrough ever
 * published.
 *
 * That needs one rewrite rule at the host: `/view/*` -> `/view/index.html`.
 * See public/_redirects. Without it, only `/view/?s=slug` works.
 */

const title = 'Walkthrough'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- A shared link should not be indexed: these are client deliverables,
         not marketing pages, and the slug is the only thing keeping one
         private. -->
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      :root {
        color-scheme: dark;
        --ink: #e8ebf0;
        --muted: #9aa3b2;
        --ground: #0b0e13;
        --panel: rgba(14, 18, 25, 0.82);
        --line: rgba(255, 255, 255, 0.12);
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; background: var(--ground); color: var(--ink);
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }
      #stage { position: fixed; inset: 0; }
      canvas { display: block; width: 100%; height: 100%; outline: none; }

      .overlay { position: fixed; pointer-events: none; z-index: 2; }
      .overlay > * { pointer-events: auto; }

      #topbar { top: 0; left: 0; right: 0; display: flex; align-items: center;
        justify-content: space-between; gap: 12px; padding: 14px 18px;
        background: linear-gradient(to bottom, rgba(0,0,0,.55), transparent); }
      #name { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
      #brand { font-size: 12px; color: var(--muted); text-decoration: none; }
      #brand:hover { color: var(--ink); }

      #controls { bottom: 0; left: 0; right: 0; display: flex; justify-content: center;
        gap: 8px; padding: 18px; }
      button {
        font: inherit; font-size: 13px; color: var(--ink); cursor: pointer;
        background: var(--panel); border: 1px solid var(--line); border-radius: 999px;
        padding: 9px 16px; backdrop-filter: blur(8px);
      }
      button:hover { border-color: rgba(255,255,255,.28); }
      button[aria-pressed='true'] { background: #2f6df6; border-color: #2f6df6; }

      #panoramaDialog { position: fixed; inset: 0; z-index: 5; display: grid;
        place-items: center; padding: 18px; background: rgba(4, 6, 10, .9); }
      #panoramaDialog[hidden] { display: none; }
      #panoramaPanel { width: min(1100px, 96vw); padding: 14px; border-radius: 14px;
        background: #10141b; border: 1px solid var(--line); box-shadow: 0 20px 80px #000; }
      #panoramaHead { display: flex; align-items: center; justify-content: space-between;
        gap: 12px; margin-bottom: 12px; }
      #panoramaHead strong { display: block; }
      #panoramaHead span { display: block; margin-top: 3px; color: var(--muted); font-size: 12px; }
      #panoramaCanvas { height: min(72vh, 680px); border-radius: 9px; cursor: grab;
        touch-action: none; background: #080a0e; }
      #panoramaStatus { position: absolute; color: var(--muted); pointer-events: none; }

      /* The view bar sits above the controls rather than beside them: on a
         phone the two together would wrap into an unusable pile, and the views
         are the thing a client actually uses. */
      #views { left: 0; right: 0; bottom: 68px; display: flex; justify-content: center;
        flex-wrap: wrap; gap: 6px; padding: 0 18px; }
      #views button { font-size: 12px; padding: 7px 13px; }

      /* Markers are DOM, not sprites: real text, selectable, legible at any
         distance, and no texture to load. The cost is positioning them each
         frame, which the viewer's after-render hook does. */
      #spots { position: fixed; inset: 0; pointer-events: none; z-index: 2; }
      .spot { position: absolute; transform: translate(-50%, -50%); pointer-events: auto;
        display: grid; place-items: center; }
      .spot > button {
        width: 26px; height: 26px; padding: 0; border-radius: 50%; font-size: 15px;
        line-height: 1; background: var(--accent, #2f6df6); border: 2px solid rgba(255,255,255,.85);
        color: #fff; box-shadow: 0 2px 10px rgba(0,0,0,.4);
      }
      .spot[data-open='true'] > button { background: #10141b; }
      .spot .card {
        position: absolute; bottom: 34px; left: 50%; transform: translateX(-50%);
        width: max-content; max-width: 260px; padding: 10px 12px; border-radius: 10px;
        background: var(--panel); border: 1px solid var(--line); backdrop-filter: blur(8px);
        text-align: left; font-size: 12px; line-height: 1.5;
      }
      .spot .card strong { display: block; margin-bottom: 2px; }
      .spot .card span { color: var(--muted); }
      .spot[data-open='false'] .card { display: none; }

      #gate { position: fixed; inset: 0; z-index: 4; display: grid; place-content: center;
        gap: 10px; padding: 24px; background: var(--ground); text-align: center; }
      #gate[hidden] { display: none; }
      #gate p { margin: 0; color: var(--muted); font-size: 13px; }
      #gate input { font: inherit; font-size: 14px; text-align: center; padding: 10px 14px;
        border-radius: 999px; border: 1px solid var(--line); background: #10141b;
        color: var(--ink); width: min(280px, 80vw); }
      #gate button { font-size: 14px; }
      #gateError { color: #ff8b8b; min-height: 18px; font-size: 12px; }

      #logo { height: 26px; width: auto; display: block; }

      #status { position: fixed; inset: 0; display: grid; place-items: center;
        text-align: center; padding: 24px; z-index: 3; background: var(--ground); }
      #status.gone { display: none; }
      #status p { color: var(--muted); font-size: 14px; margin: 8px 0 0; }
      .bar { width: 220px; height: 3px; border-radius: 999px; overflow: hidden;
        background: rgba(255,255,255,.1); margin: 16px auto 0; }
      .bar > i { display: block; height: 100%; width: 0; background: #2f6df6;
        transition: width .25s ease; }

      /* Credits sit behind a toggle rather than on screen permanently: the
         obligation is to make attribution available, not to put it over the
         client's living room. */
      #credits { position: fixed; right: 18px; bottom: 68px; max-width: min(360px, 78vw);
        max-height: 46vh; overflow: auto; padding: 14px 16px; border-radius: 12px;
        background: var(--panel); border: 1px solid var(--line); backdrop-filter: blur(8px);
        font-size: 12px; line-height: 1.55; z-index: 2; }
      #credits[hidden] { display: none; }

      #note { position: fixed; right: 18px; bottom: 68px; width: min(360px, 78vw);
        display: grid; gap: 8px; padding: 14px 16px; border-radius: 12px;
        background: var(--panel); border: 1px solid var(--line); backdrop-filter: blur(8px);
        font-size: 13px; z-index: 2; }
      #note[hidden] { display: none; }
      #note textarea, #note input[type='text'] {
        font: inherit; color: var(--ink); background: #10141b; width: 100%;
        border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; resize: vertical;
      }
      #noteRow { display: flex; align-items: center; gap: 10px; }
      #noteStatus { color: var(--muted); font-size: 12px; }
      #credits h2 { margin: 0 0 8px; font-size: 12px; text-transform: uppercase;
        letter-spacing: .08em; color: var(--muted); font-weight: 600; }
      #credits a { color: inherit; }
      #credits li { margin-bottom: 6px; list-style: none; }
      #credits ul { margin: 0; padding: 0; }
      .lic { color: var(--muted); }
    </style>
  </head>

  <body>
    <div id="stage"><canvas id="canvas"></canvas></div>

    <div class="overlay" id="topbar">
      <div id="name">Loading…</div>
      <a id="brand" href={brand.domains.marketing} target="_blank" rel="noreferrer">
        Made with {brand.name}
      </a>
    </div>

    <div id="spots"></div>

    <div class="overlay" id="views" hidden></div>

    <div class="overlay" id="controls" hidden>
      <button id="walk" aria-pressed="false">Walk through it</button>
      <!-- One button per storey, filled in from the model's own geometry and
           shown only while walking a multi-storey scene. Movement is
           deliberately horizontal and stairs are not modelled, so without
           this the upper floors of a published walkthrough were visible and
           unreachable. -->
      <span id="floors" hidden></span>
      <button id="fit">Overview</button>
      <button id="panoramaToggle" hidden>View 360</button>
      <!-- Shown only when the device can actually present immersive VR — a flat
           browser must not offer a button that does nothing. -->
      <button id="viewVr" hidden>View in VR</button>
      <button id="creditsToggle" aria-pressed="false" hidden>Credits</button>
      <button id="noteToggle" aria-pressed="false">Leave a note</button>
    </div>

    <!--
      The note form. Feedback TO the author, never a message board: nothing a
      visitor writes here is ever shown to another visitor, which is what makes
      the endpoint safe to leave open and this panel free of anyone else's text.
    -->
    <form id="note" hidden>
      <strong>Send a note to the architect</strong>
      <textarea
        id="noteMessage"
        rows="4"
        maxlength="2000"
        placeholder="Can the kitchen wall move half a metre?"></textarea>
      <input id="noteName" type="text" maxlength="80" placeholder="Your name (optional)" />
      <div id="noteRow">
        <button type="submit" id="noteSend">Send</button>
        <span id="noteStatus" role="status"></span>
      </div>
    </form>

    <aside id="credits" hidden>
      <h2>Models</h2>
      <ul id="creditList"></ul>
    </aside>

    <div id="panoramaDialog" role="dialog" aria-modal="true" aria-labelledby="panoramaTitle" hidden>
      <div id="panoramaPanel">
        <div id="panoramaHead">
          <div>
            <strong id="panoramaTitle">360 panorama</strong>
            <span>Drag to look around. Use the wheel to zoom.</span>
          </div>
          <button id="panoramaClose" type="button">Close</button>
        </div>
        <div style="position: relative; display: grid; place-items: center;">
          <canvas id="panoramaCanvas" aria-label="Interactive 360 panorama"></canvas>
          <span id="panoramaStatus">Loading panorama...</span>
        </div>
      </div>
    </div>

    <form id="gate" hidden>
      <strong>This walkthrough is private</strong>
      <p id="gateName"></p>
      <input id="code" type="password" autocomplete="off" placeholder="Access code"
             aria-label="Access code" />
      <button type="submit">Open</button>
      <p id="gateError" role="alert"></p>
    </form>

    <div id="status">
      <div>
        <strong id="statusTitle">Loading the walkthrough</strong>
        <p id="statusDetail">Fetching the scene…</p>
        <div class="bar"><i id="statusBar"></i></div>
      </div>
    </div>

    <!--
      The watchdog. Inline and classic ON PURPOSE — it must run even when
      module loading is broken, because module loading being broken is the
      exact failure it reports.

      The walkthrough script is a module graph: this page's script, the shared
      viewer, three.js and its loaders. If ANY edge fails — a CDN hiccup, an
      ad-blocker, a flaky mobile connection, a stale dev cache — the module
      never evaluates, `main()` and its catch never exist, and the client sits
      on the static "Fetching the scene…" text forever. Measured, not
      hypothetical: a stale Vite dep cache 504'd the three.js chunks and this
      page hung silently with a clean console.

      The module's first act is to set `__arcviaAlive`. If that has not
      happened shortly after the window loads, the script did not arrive, and
      saying so beats loading text that never resolves. The timer starts at
      `load` rather than at parse so a slow model download is not misreported —
      by `load` the only thing outstanding is script evaluation, which is fast
      or failed.
    -->
    <script is:inline>
      window.addEventListener('load', function () {
        setTimeout(function () {
          if (window.__arcviaAlive) return
          var title = document.getElementById('statusTitle')
          var detail = document.getElementById('statusDetail')
          var bar = document.getElementById('statusBar')
          if (title) title.textContent = 'Could not start the walkthrough'
          if (detail)
            detail.textContent =
              'The viewer failed to load. Check your connection — or an ad-blocker — and reload the page.'
          if (bar && bar.parentElement) bar.parentElement.style.display = 'none'
        }, 4000)
      })
    </script>

    <script>
      import { PanoramaViewer, SceneViewer, WalkController } from '@arcvia/viewer'
      import { mountConfigurator } from '../../lib/configurator'


      const api =
        import.meta.env.PUBLIC_API_URL ??
        `${window.location.protocol}//${window.location.hostname}:8787`

      /**
       * The slug, from `/view/<slug>/` or `?s=<slug>`.
       *
       * Both are supported because the path form needs a rewrite rule at the
       * host and the query form does not. A deployment without the rewrite
       * still works; it just has uglier links.
       */
      function slugFromLocation() {
        const query = new URLSearchParams(location.search).get('s')
        if (query) return query
        const parts = location.pathname.split('/').filter(Boolean)
        return parts[0] === 'view' && parts[1] ? decodeURIComponent(parts[1]) : null
      }

      /**
       * One clickable marker in the scene, as the API sends it.
       *
       * `title` is required because the code reads it unconditionally, into an
       * aria-label as well as the card — a marker with no title is an unlabelled
       * button, which is worse than no marker.
       */
      type Hotspot = {
        position: { x: number; y: number; z: number }
        title: string
        body?: string
        link?: string
      }

      /** An attribution line for one model, as the API sends it. */
      type Credit = { source: string; author: string; licence: string }

      /**
       * One of this page's own elements, or a loud failure.
       *
       * Every id below is in the markup a few lines up, so at runtime these
       * always resolve — until someone renames one. `getElementById` answers
       * `null` for a missing id, and the code that follows assumes an element,
       * so the symptom of that rename is a client opening a link and getting a
       * blank screen with a TypeError in a console they will never open.
       *
       * Throwing here instead names the id that went missing. It is the same
       * broken page either way; the difference is whether anyone can tell why.
       * `astro check` also stops reporting the assumption 36 times.
       */
      const must = (id: string) => {
        const el = document.getElementById(id)
        if (!el) throw new Error(`view: #${id} is missing from this page`)
        return el
      }

      const els = {
        status: must('status'),
        title: must('statusTitle'),
        detail: must('statusDetail'),
        bar: must('statusBar'),
        name: must('name'),
        controls: must('controls'),
        walk: must('walk'),
        floors: must('floors'),
        fit: must('fit'),
        panoramaToggle: must('panoramaToggle'),
        panoramaDialog: must('panoramaDialog'),
        panoramaClose: must('panoramaClose'),
        panoramaStatus: must('panoramaStatus'),
        viewVr: must('viewVr'),
        credits: must('credits'),
        creditList: must('creditList'),
        creditsToggle: must('creditsToggle'),
        views: must('views'),
        spots: must('spots'),
        note: must('note'),
        noteToggle: must('noteToggle'),
        noteMessage: must('noteMessage'),
        noteName: must('noteName'),
        noteSend: must('noteSend'),
        noteStatus: must('noteStatus'),
      }

      // Looked up once and shared. The viewer and the walk controller both need
      // it, and two lookups is two chances to drift apart.
      const canvas = must('canvas') as HTMLCanvasElement

      const fail = (title: string, detail: string) => {
        els.title.textContent = title
        els.detail.textContent = detail
        const track = els.bar.parentElement
        if (track) track.style.display = 'none'
      }

      // Takes a real string, not an optional one. Every call site already
      // guards on the field being present — a missing model is a `fail()` a few
      // lines up, not something to paper over here — and typing the parameter
      // optional would have made those guards look unnecessary.
      const absolute = (url: string) => (url.startsWith('/') ? api + url : url)

      /** Add the public-page modal controls around the shared renderer. */
      function createPanorama(src: string) {
        const dialog = els.panoramaDialog
        const canvas = must('panoramaCanvas') as HTMLCanvasElement
        const status = els.panoramaStatus
        const panorama = new PanoramaViewer({
          canvas,
          src,
          onLoad: () => {
            status.hidden = true
          },
          onError: () => {
            status.textContent = 'The panorama could not be loaded.'
          },
        })
        const close = () => {
          dialog.hidden = true
          els.panoramaToggle.setAttribute('aria-pressed', 'false')
          els.panoramaToggle.focus()
        }
        const onKey = (event: KeyboardEvent) => {
          if (event.key === 'Escape' && !dialog.hidden) close()
        }
        const onBackdrop = (event: Event) => {
          if (event.target === dialog) close()
        }

        window.addEventListener('keydown', onKey)
        els.panoramaClose.addEventListener('click', close)
        dialog.addEventListener('click', onBackdrop)

        return {
          open() {
            dialog.hidden = false
            els.panoramaToggle.setAttribute('aria-pressed', 'true')
            els.panoramaClose.focus()
            panorama.resize()
          },
          dispose() {
            window.removeEventListener('keydown', onKey)
            els.panoramaClose.removeEventListener('click', close)
            dialog.removeEventListener('click', onBackdrop)
            panorama.dispose()
          },
        }
      }
      /**
       * Ask for the access code and exchange it for the scene.
       *
       * Resolves with the scene once a code works, and never otherwise — a
       * wrong code re-prompts rather than failing the page, because the usual
       * reason for one is a typo or the wrong line of an email.
       *
       * The code is never stored. Remembering it would spare a returning
       * visitor one step and would also mean a shared laptop keeps access to a
       * pre-launch property, which is the thing the gate exists to prevent.
       */
      function unlock(slug: string, name?: string) {
        const gate = must('gate') as HTMLFormElement
        const input = must('code') as HTMLInputElement
        const error = must('gateError')

        must('gateName').textContent = name ?? ''
        els.status.classList.add('gone')
        gate.hidden = false
        input.focus()

        return new Promise((resolve) => {
          gate.addEventListener('submit', async (event) => {
            event.preventDefault()
            error.textContent = ''

            // The success path used to `await attempt.json()` with no guard, so
            // a network failure or a malformed 200 threw out of this async
            // listener into nothing: the visitor pressed Open with the right
            // code from their email and NOTHING happened — no error, no
            // progress, indistinguishable from a broken button. A CORS
            // misconfiguration triggers exactly this, since the unlock POST
            // preflights while the initial GET did not. Every path now writes
            // something the visitor can read.
            let attempt: Response
            try {
              attempt = await fetch(
                `${api}/scenes/public/${encodeURIComponent(slug)}/unlock`,
                {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ code: input.value }),
                  signal: AbortSignal.timeout(15_000),
                },
              )
            } catch {
              error.textContent = 'Could not reach the server. Check your connection and try again.'
              return
            }

            if (attempt.ok) {
              const body = await attempt.json().catch(() => null)
              if (!body || !body.scene) {
                error.textContent = 'The walkthrough could not be opened. Please reload the page.'
                return
              }
              gate.hidden = true
              els.status.classList.remove('gone')
              resolve(body.scene)
              return
            }

            // 429 carries its own message about waiting, which is more useful
            // than a generic "wrong code" when the reason is a lockout.
            const body = await attempt.json().catch(() => ({}))
            error.textContent = body.message ?? 'That code did not work.'
            input.select()
          })
        })
      }

      async function main() {
        const slug = slugFromLocation()
        if (!slug) return fail('No walkthrough specified', 'This link is missing its scene.')

        // ── A fetch with no timeout can hang this page forever ───────────────
        // `await fetch(...)` with no signal neither resolves nor rejects if the
        // server accepts the connection and never replies — a wedged proxy, a
        // dead backend behind a live load balancer. The page then sits on
        // "Fetching the scene…" indefinitely, and the module-load watchdog
        // cannot help because the module DID load. So: a 15 s deadline, and a
        // try/catch that turns a network failure into a screen a visitor can
        // act on rather than a spinner that never stops.
        let response: Response
        try {
          response = await fetch(`${api}/scenes/public/${encodeURIComponent(slug)}`, {
            signal: AbortSignal.timeout(15_000),
          })
        } catch {
          return fail(
            'Could not reach the walkthrough',
            'The server did not respond. Check your connection and reload the page.',
          )
        }
        if (!response.ok) {
          // 5xx is the server failing, not a wrong link — telling a client with
          // a correct link that it "may be wrong" sends them to argue with the
          // developer over nothing.
          return response.status >= 500
            ? fail('The walkthrough is temporarily unavailable', 'Please try again in a few minutes.')
            : fail(
                'Walkthrough not found',
                'The link may be wrong, or the scene may have been unpublished.',
              )
        }

        let scene
        try {
          ;({ scene } = await response.json())
        } catch {
          return fail('The walkthrough could not be read', 'The scene data was malformed. Please reload.')
        }

        // ---- Gated scenes ---------------------------------------------------
        // A protected scene arrives with its name and nothing that renders it,
        // so there is nothing to show until a code is exchanged. The name is
        // displayed: a visitor needs to know they are in the right place before
        // being asked for a credential.
        if (scene.protected) {
          scene = await unlock(slug, scene.name)
          if (!scene) return
        }

        document.title = scene.name ? `${scene.name} — Walkthrough` : 'Walkthrough'
        els.name.textContent = scene.name ?? 'Walkthrough'

        if (!scene.modelUrl) {
          return fail('Nothing to show yet', 'This scene was published before it had any geometry.')
        }

        const viewer = new SceneViewer({
          canvas,
          onProgress: (fraction: number) => {
            els.bar.style.width = `${Math.round(fraction * 100)}%`
            els.detail.textContent = 'Loading the model…'
          },
          onError: (error: Error) => fail('Could not load the walkthrough', error.message),
        })

        await viewer.loadModel(absolute(scene.modelUrl))

        // The bake, if there is one. Applied before the first frame is shown, so
        // the client never sees the flat version and then a jump.
        //
        // One call into the shared viewer rather than the material walk this
        // page used to do inline — that duplicate had a bug the studio's copy
        // did not, and rendered an empty sky. See applyBakedLightmap.
        if (scene.bakedUrl) {
          els.detail.textContent = 'Loading the lighting…'
          // A missing or unreadable atlas is a flatter room, not a broken page.
          const lit = await viewer.applyBakedLightmap(absolute(scene.bakedUrl)).catch(() => 0)
          if (lit === 0) console.warn('The bake did not apply; showing real-time lighting.')
        }

        viewer.frameModel()

        // A panorama is optional and intentionally lazy: do not download a
        // 4096x2048 image unless the visitor asks to see it.
        if (scene.panoramaUrl) {
          let panorama: ReturnType<typeof createPanorama> | null = null
          els.panoramaToggle.hidden = false
          els.panoramaToggle.addEventListener('click', () => {
            panorama ??= createPanorama(absolute(scene.panoramaUrl))
            panorama.open()
          })
          window.addEventListener('beforeunload', () => panorama?.dispose(), { once: true })
        }

        // ---- The configurator -----------------------------------------------
        // Finish switching, mounted only when the author composed options for
        // this scene. After the bake on purpose: mountConfigurator leaves
        // `lightMap` alone precisely so a switch keeps the baked lighting, and
        // mounting before the bake applied would put the picker on screen while
        // the floors it recolours were still loading.
        if (scene.options) {
          mountConfigurator(
            els.controls,
            scene.options,
            () => viewer.modelRoot,
            absolute,
            () => viewer.requestRender(),
            {
              // The summary PDF: the frame on screen, the choices that applied,
              // and the attribution for everything shipped. `snapshot` renders
              // and reads in one task, which is what makes capture work without
              // preserveDrawingBuffer.
              title: scene.name ?? 'Walkthrough',
              capture: () => viewer.snapshot({ width: 1200 }),
              credits: (scene.credits ?? []).map(
                (credit: { author: string; licence: string }) =>
                  `${credit.author} (${credit.licence})`,
              ),
            },
          )
        }

        const walk = new WalkController(viewer, canvas, {
          eyeHeight: 1.6,
          speed: 2.68,
        })

        let walking = false

        // ---- The floor switcher ---------------------------------------------
        // Derived from the model's own geometry (publicPayload carries no
        // plan), built once, shown only while walking a multi-storey scene.
        // `standInside` always lands the visitor on the LOWEST floor, and
        // movement is horizontal with no stairs modelled — so before this,
        // the upper storeys of a published multi-storey walkthrough were
        // visible and unreachable.
        const floors = viewer.floorLevels()
        const floorButtons: HTMLButtonElement[] = []
        const markFloor = (active: number) => {
          floorButtons.forEach((b, i) =>
            b.setAttribute('aria-pressed', String(i === active)),
          )
        }
        floors.forEach((floor: { label: string; level: number; centre: { x: number; z: number } }, i: number) => {
          const button = document.createElement('button')
          button.type = 'button'
          button.textContent = floor.label
          button.setAttribute('aria-pressed', 'false')
          button.addEventListener('click', () => {
            // Arrive at the storey's centre, not wherever the eye was on the
            // previous floor — the same x/z on another storey is as likely to
            // be inside a wall as inside a room.
            viewer.cameraObject.position.set(floor.centre.x, floor.level + 1.6, floor.centre.z)
            walk.setFloorLevel(floor.level)
            markFloor(i)
          })
          els.floors.appendChild(button)
          floorButtons.push(button)
        })

        els.walk.addEventListener('click', () => {
          walking = !walking
          els.walk.setAttribute('aria-pressed', String(walking))
          els.walk.textContent = walking ? 'Leave walkthrough' : 'Walk through it'
          if (walking) {
            // Stand inside before enabling, or the visitor enters the
            // walkthrough in the garden looking at the building.
            viewer.standInside(1.6)
            // Wider inside than out, and brisker than a real walking pace: at
            // 50 degrees a small room fills the screen with one wall, and at
            // 2.7 m/s a client spends the tour stopping and turning.
            viewer.setFieldOfView(72)
            walk.setSpeed(4.5)
            walk.enable()
            if (floors.length) {
              // standInside stood the visitor on the lowest floor; say so.
              markFloor(0)
              els.floors.hidden = false
            }
          } else {
            walk.disable()
            viewer.setFieldOfView(50)
            viewer.frameModel()
            els.floors.hidden = true
          }
        })

        els.fit.addEventListener('click', () => {
          if (walking) els.walk.click()
          else viewer.frameModel()
        })

        // ---- View in VR -----------------------------------------------------
        // The button reveals itself only on a device that can actually present
        // immersive VR — asked once, after the model is up. On a phone or a
        // desktop with no headset the check returns false and the button stays
        // hidden, so nobody is offered a control that does nothing. A failed or
        // refused session (permission denied, headset busy) writes to the gate
        // error line and leaves the flat walkthrough exactly as it was.
        void viewer.isVRSupported().then((supported: boolean) => {
          if (!supported) return
          els.viewVr.hidden = false
          els.viewVr.addEventListener('click', () => {
            viewer.enterVR().catch((error: Error) => {
              els.detail.textContent =
                'Could not start VR — ' + (error?.message ?? 'the headset refused the session.')
              els.status.classList.remove('gone')
              window.setTimeout(() => els.status.classList.add('gone'), 4000)
            })
          })
        })

        // ---- Branding -------------------------------------------------------
        // Applied before anything is shown, so a client never sees Arcvia blue
        // flash to the developer's colour.
        const branding = scene.branding ?? {}
        if (branding.accent) document.documentElement.style.setProperty('--accent', branding.accent)
        if (branding.logoUrl) {
          const logo = document.createElement('img')
          logo.id = 'logo'
          logo.src = absolute(branding.logoUrl)
          logo.alt = scene.name ?? ''
          els.name.replaceWith(logo)
        }
        if (branding.hideCredit) document.getElementById('brand')?.remove()

        // ---- Notes to the architect ------------------------------------------
        // The view the visitor last jumped to rides along with the note, so
        // "this window feels small" arrives pinned to the Kitchen rather than
        // to the whole building.
        let lastViewName = ''

        els.noteToggle.addEventListener('click', () => {
          const open = els.note.hidden
          els.note.hidden = !open
          els.noteToggle.setAttribute('aria-pressed', String(open))
          if (open) (els.noteMessage as HTMLTextAreaElement).focus()
        })

        els.note.addEventListener('submit', (event) => {
          event.preventDefault()
          const message = (els.noteMessage as HTMLTextAreaElement).value.trim()
          if (!message) {
            els.noteStatus.textContent = 'Write the note first.'
            return
          }
          ;(els.noteSend as HTMLButtonElement).disabled = true
          els.noteStatus.textContent = 'Sending…'
          void fetch(`${api}/scenes/public/${encodeURIComponent(slug ?? '')}/comments`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message,
              name: (els.noteName as HTMLInputElement).value.trim(),
              view: lastViewName,
            }),
            // Without this, a stalled connection leaves "Sending…" and a
            // disabled button for as long as the socket dangles — the same
            // dead-control class as the gate's Open button before b4a114b.
            signal: AbortSignal.timeout(10_000),
          })
            .then(async (response) => {
              if (response.ok) {
                ;(els.noteMessage as HTMLTextAreaElement).value = ''
                els.noteStatus.textContent = 'Sent. The architect will see it.'
                return
              }
              // The server's refusals are written for people — the length
              // limit, the throttle — so they are shown, not translated.
              const payload = (await response.json().catch(() => ({}))) as { message?: string }
              els.noteStatus.textContent = payload.message ?? 'Could not send it. Try again.'
            })
            .catch(() => {
              els.noteStatus.textContent = 'Could not send it. Check your connection.'
            })
            .finally(() => {
              ;(els.noteSend as HTMLButtonElement).disabled = false
            })
        })

        // ---- Named views ----------------------------------------------------
        const views = scene.views ?? []
        if (views.length > 0) {
          els.views.hidden = false
          for (const view of views) {
            const button = document.createElement('button')
            button.textContent = view.name
            button.addEventListener('click', () => {
              // Leave first-person before jumping: arriving at a named view
              // still in walk mode drops the visitor there with the pointer
              // locked, which reads as the view having failed.
              if (walking) els.walk.click()
              viewer.goToView(view)
              lastViewName = view.name
            })
            els.views.appendChild(button)
          }
          // Open on the first view rather than an overview. It is the shot the
          // author chose to lead with, and an overview of a single flat is
          // rarely the most flattering thing to open on.
          viewer.goToView(views[0], false)
        }

        // ---- Hotspots -------------------------------------------------------
        const hotspots = scene.hotspots ?? []
        const markers = hotspots.map((hotspot: Hotspot) => {
          const marker = document.createElement('div')
          marker.className = 'spot'
          marker.dataset.open = 'false'

          const dot = document.createElement('button')
          dot.type = 'button'
          dot.textContent = '+'
          dot.setAttribute('aria-label', hotspot.title)

          const card = document.createElement('div')
          card.className = 'card'
          const title = document.createElement('strong')
          title.textContent = hotspot.title
          card.appendChild(title)
          if (hotspot.body) {
            const body = document.createElement('span')
            body.textContent = hotspot.body
            card.appendChild(body)
          }
          if (hotspot.link) {
            const link = document.createElement('a')
            link.href = hotspot.link
            link.target = '_blank'
            link.rel = 'noreferrer noopener'
            link.textContent = 'More'
            card.appendChild(document.createElement('br'))
            card.appendChild(link)
          }

          dot.addEventListener('click', () => {
            const open = marker.dataset.open === 'true'
            // One card at a time: two overlapping cards in a small room is
            // unreadable, and the second click is almost always "show me that
            // one instead".
            for (const other of markers) other.el.dataset.open = 'false'
            marker.dataset.open = String(!open)
            dot.textContent = !open ? '×' : '+'
          })

          marker.append(dot, card)
          els.spots.appendChild(marker)
          return { el: marker, hotspot, dot }
        })

        // Positioned after every draw. Markers track the geometry they label,
        // so they have to be recomputed whenever the camera moves at all.
        if (markers.length > 0) {
          viewer.onAfterRender = () => {
            for (const { el, hotspot } of markers) {
              const at = viewer.project(hotspot.position)
              el.style.display = at.visible ? '' : 'none'
              if (!at.visible) continue
              el.style.left = at.x + 'px'
              el.style.top = at.y + 'px'
              // Fade with distance rather than hiding: a marker that vanishes
              // as you back away looks broken, one that recedes looks placed.
              el.style.opacity = String(Math.max(0.35, Math.min(1, 12 / at.distance)))
            }
          }
        }

        // Attribution. Present when it is owed, absent when it is not.
        const credits = scene.credits ?? []
        if (credits.length > 0) {
          els.creditsToggle.hidden = false
          // ── Built as nodes, never as an HTML string ──────────────────────
          // credit.author / .source / .licence are user-supplied: `credits` is
          // on the scene PATCH allow-list with no schema, and publicPayload
          // returns them verbatim to any visitor. Interpolated into innerHTML,
          // an author of `<img src=x onerror=…>` was arbitrary JavaScript on
          // the developer's own branded domain — the same origin that stores
          // the bearer token — firing on load even with the panel hidden
          // (`display:none` does not stop `onerror`). This was the only
          // innerHTML on the page; every other user string here already uses
          // textContent, and this now matches. `href` is set only for a real
          // http(s) URL, so a `javascript:` source cannot become a live link.
          els.creditList.replaceChildren(
            ...credits.map((credit: Credit) => {
              const li = document.createElement('li')
              const source = String(credit.source ?? '')
              if (/^https?:\/\//i.test(source)) {
                const a = document.createElement('a')
                a.href = source
                a.target = '_blank'
                a.rel = 'noreferrer'
                a.textContent = credit.author ?? ''
                li.appendChild(a)
              } else {
                // No safe URL — show the name as plain text rather than a link
                // to nowhere or to something dangerous.
                li.textContent = credit.author ?? ''
              }
              const lic = document.createElement('span')
              lic.className = 'lic'
              lic.textContent = ` — ${credit.licence ?? ''}`
              li.appendChild(lic)
              return li
            }),
          )
          els.creditsToggle.addEventListener('click', () => {
            const open = els.credits.hasAttribute('hidden')
            els.credits.toggleAttribute('hidden', !open)
            els.creditsToggle.setAttribute('aria-pressed', String(open))
          })
        }

        els.status.classList.add('gone')
        els.controls.hidden = false
      }

      // The watchdog is waiting for this. Deliberately the LAST top-level
      // statement: a failed import never reaches it, and neither does a throw
      // anywhere above — a renamed element id, a syntax error in an edit — so
      // both failure shapes surface instead of hanging. `main` is async and
      // owns its own failures via the catch below.
      ;(window as unknown as { __arcviaAlive?: boolean }).__arcviaAlive = true

      main().catch((error) =>
        fail('Something went wrong', error?.message ?? 'The walkthrough could not be opened.'),
      )
    </script>
  </body>
</html>
