{
  "name": "@arcvia/building-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Arcvia semantic building and build-plan contracts.",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./buildplan": {
      "types": "./src/buildplan.ts",
      "default": "./src/buildplan.ts"
    },
    "./fit": {
      "types": "./src/fit.d.mts",
      "default": "./src/fit.mjs"
    },
    "./schema/building-1.json": "./schema/building-1.json"
  },
  "files": [
    "src",
    "schema"
  ],
  "scripts": {
    "check": "tsc --project tsconfig.json --noEmit --pretty false",
    "generate:schema": "ts-json-schema-generator --path src/schema.ts --type BuildingModel --tsconfig tsconfig.json --out schema/building-1.json",
    "test": "node test/schema-parity.mjs"
  },
  "devDependencies": {
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.7.2"
  }
}
