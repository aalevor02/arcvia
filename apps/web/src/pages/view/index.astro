---
import brand from '@arcvia/brand'

/**
 * The published walkthrough — what a client actually opens.
 *
 * ── Why this page is the product ────────────────────────────────────────────
 * Everything upstream of here is a tool for making this page. A buyer never
 * sees the plan editor, the catalogue or the bake queue; they get a link, and
 * this is what is behind it. If this page is not convincing, none of the rest
 * counts.
 *
 * ── Why it is static ────────────────────────────────────────────────────────
 * The site builds to plain HTML with no Node process in production, which is
 * what makes hosting cost pennies. A slug cannot be prerendered — scenes are
 * published after the build — so the slug is read from the path at runtime and
 * the scene fetched from the API. One HTML file serves every walkthrough ever
 * published.
 *
 * That needs one rewrite rule at the host: `/view/*` -> `/view/index.html`.
 * See public/_redirects. Without it, only `/view/?s=slug` works.
 */

const title = 'Walkthrough'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- A shared link should not be indexed: these are client deliverables,
         not marketing pages, and the slug is the only thing keeping one
         private. -->
    <meta name="robots" content="noindex, nofollow" />
    <style is:global>
      :root {
        color-scheme: dark;
        --ink: #e8ebf0;
        --muted: #9aa3b2;
        --ground: #0b0e13;
        --panel: rgba(14, 18, 25, 0.82);
        --line: rgba(255, 255, 255, 0.12);
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; background: var(--ground); color: var(--ink);
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }
      #stage { position: fixed; inset: 0; }
      canvas { display: block; width: 100%; height: 100%; outline: none; }

      .overlay { position: fixed; pointer-events: none; z-index: 2; }
      .overlay > * { pointer-events: auto; }

      #topbar { top: 0; left: 0; right: 0; display: flex; align-items: center;
        justify-content: space-between; gap: 12px; padding: 14px 18px;
        background: linear-gradient(to bottom, rgba(0,0,0,.55), transparent); }
      #name { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
      #brand { font-size: 12px; color: var(--muted); text-decoration: none; }
      #brand:hover { color: var(--ink); }

      #controls { bottom: 0; left: 0; right: 0; display: flex; justify-content: center;
        gap: 8px; padding: 18px; }
      button {
        font: inherit; font-size: 13px; color: var(--ink); cursor: pointer;
        background: var(--panel); border: 1px solid var(--line); border-radius: 999px;
        padding: 9px 16px; backdrop-filter: blur(8px);
      }
      button:hover { border-color: rgba(255,255,255,.28); }
      button[aria-pressed='true'] { background: #2f6df6; border-color: #2f6df6; }

      /* The view bar sits above the controls rather than beside them: on a
         phone the two together would wrap into an unusable pile, and the views
         are the thing a client actually uses. */
      #views { left: 0; right: 0; bottom: 68px; display: flex; justify-content: center;
        flex-wrap: wrap; gap: 6px; padding: 0 18px; }
      #views button { font-size: 12px; padding: 7px 13px; }

      /* Markers are DOM, not sprites: real text, selectable, legible at any
         distance, and no texture to load. The cost is positioning them each
         frame, which the viewer's after-render hook does. */
      #spots { position: fixed; inset: 0; pointer-events: none; z-index: 2; }
      .spot { position: absolute; transform: translate(-50%, -50%); pointer-events: auto;
        display: grid; place-items: center; }
      .spot > button {
        width: 26px; height: 26px; padding: 0; border-radius: 50%; font-size: 15px;
        line-height: 1; background: var(--accent, #2f6df6); border: 2px solid rgba(255,255,255,.85);
        color: #fff; box-shadow: 0 2px 10px rgba(0,0,0,.4);
      }
      .spot[data-open='true'] > button { background: #10141b; }
      .spot .card {
        position: absolute; bottom: 34px; left: 50%; transform: translateX(-50%);
        width: max-content; max-width: 260px; padding: 10px 12px; border-radius: 10px;
        background: var(--panel); border: 1px solid var(--line); backdrop-filter: blur(8px);
        text-align: left; font-size: 12px; line-height: 1.5;
      }
      .spot .card strong { display: block; margin-bottom: 2px; }
      .spot .card span { color: var(--muted); }
      .spot[data-open='false'] .card { display: none; }

      #gate { position: fixed; inset: 0; z-index: 4; display: grid; place-content: center;
        gap: 10px; padding: 24px; background: var(--ground); text-align: center; }
      #gate[hidden] { display: none; }
      #gate p { margin: 0; color: var(--muted); font-size: 13px; }
      #gate input { font: inherit; font-size: 14px; text-align: center; padding: 10px 14px;
        border-radius: 999px; border: 1px solid var(--line); background: #10141b;
        color: var(--ink); width: min(280px, 80vw); }
      #gate button { font-size: 14px; }
      #gateError { color: #ff8b8b; min-height: 18px; font-size: 12px; }

      #logo { height: 26px; width: auto; display: block; }

      #status { position: fixed; inset: 0; display: grid; place-items: center;
        text-align: center; padding: 24px; z-index: 3; background: var(--ground); }
      #status.gone { display: none; }
      #status p { color: var(--muted); font-size: 14px; margin: 8px 0 0; }
      .bar { width: 220px; height: 3px; border-radius: 999px; overflow: hidden;
        background: rgba(255,255,255,.1); margin: 16px auto 0; }
      .bar > i { display: block; height: 100%; width: 0; background: #2f6df6;
        transition: width .25s ease; }

      /* Credits sit behind a toggle rather than on screen permanently: the
         obligation is to make attribution available, not to put it over the
         client's living room. */
      #credits { position: fixed; right: 18px; bottom: 68px; max-width: min(360px, 78vw);
        max-height: 46vh; overflow: auto; padding: 14px 16px; border-radius: 12px;
        background: var(--panel); border: 1px solid var(--line); backdrop-filter: blur(8px);
        font-size: 12px; line-height: 1.55; z-index: 2; }
      #credits[hidden] { display: none; }
      #credits h2 { margin: 0 0 8px; font-size: 12px; text-transform: uppercase;
        letter-spacing: .08em; color: var(--muted); font-weight: 600; }
      #credits a { color: inherit; }
      #credits li { margin-bottom: 6px; list-style: none; }
      #credits ul { margin: 0; padding: 0; }
      .lic { color: var(--muted); }
    </style>
  </head>

  <body>
    <div id="stage"><canvas id="canvas"></canvas></div>

    <div class="overlay" id="topbar">
      <div id="name">Loading…</div>
      <a id="brand" href={brand.domains.marketing} target="_blank" rel="noreferrer">
        Made with {brand.name}
      </a>
    </div>

    <div id="spots"></div>

    <div class="overlay" id="views" hidden></div>

    <div class="overlay" id="controls" hidden>
      <button id="walk" aria-pressed="false">Walk through it</button>
      <button id="fit">Overview</button>
      <button id="creditsToggle" aria-pressed="false" hidden>Credits</button>
    </div>

    <aside id="credits" hidden>
      <h2>Models</h2>
      <ul id="creditList"></ul>
    </aside>

    <form id="gate" hidden>
      <strong>This walkthrough is private</strong>
      <p id="gateName"></p>
      <input id="code" type="password" autocomplete="off" placeholder="Access code"
             aria-label="Access code" />
      <button type="submit">Open</button>
      <p id="gateError" role="alert"></p>
    </form>

    <div id="status">
      <div>
        <strong id="statusTitle">Loading the walkthrough</strong>
        <p id="statusDetail">Fetching the scene…</p>
        <div class="bar"><i id="statusBar"></i></div>
      </div>
    </div>

    <script>
      import { SceneViewer, WalkController } from '@arcvia/viewer'

      const api =
        import.meta.env.PUBLIC_API_URL ??
        `${window.location.protocol}//${window.location.hostname}:8787`

      /**
       * The slug, from `/view/<slug>/` or `?s=<slug>`.
       *
       * Both are supported because the path form needs a rewrite rule at the
       * host and the query form does not. A deployment without the rewrite
       * still works; it just has uglier links.
       */
      function slugFromLocation() {
        const query = new URLSearchParams(location.search).get('s')
        if (query) return query
        const parts = location.pathname.split('/').filter(Boolean)
        return parts[0] === 'view' && parts[1] ? decodeURIComponent(parts[1]) : null
      }

      const els = {
        status: document.getElementById('status'),
        title: document.getElementById('statusTitle'),
        detail: document.getElementById('statusDetail'),
        bar: document.getElementById('statusBar'),
        name: document.getElementById('name'),
        controls: document.getElementById('controls'),
        walk: document.getElementById('walk'),
        fit: document.getElementById('fit'),
        credits: document.getElementById('credits'),
        creditList: document.getElementById('creditList'),
        creditsToggle: document.getElementById('creditsToggle'),
        views: document.getElementById('views'),
        spots: document.getElementById('spots'),
      }

      const fail = (title, detail) => {
        els.title.textContent = title
        els.detail.textContent = detail
        els.bar.parentElement.style.display = 'none'
      }

      const absolute = (url) => (url?.startsWith('/') ? api + url : url)

      /**
       * Ask for the access code and exchange it for the scene.
       *
       * Resolves with the scene once a code works, and never otherwise — a
       * wrong code re-prompts rather than failing the page, because the usual
       * reason for one is a typo or the wrong line of an email.
       *
       * The code is never stored. Remembering it would spare a returning
       * visitor one step and would also mean a shared laptop keeps access to a
       * pre-launch property, which is the thing the gate exists to prevent.
       */
      function unlock(slug, name) {
        const gate = document.getElementById('gate')
        const input = document.getElementById('code')
        const error = document.getElementById('gateError')

        document.getElementById('gateName').textContent = name ?? ''
        els.status.classList.add('gone')
        gate.hidden = false
        input.focus()

        return new Promise((resolve) => {
          gate.addEventListener('submit', async (event) => {
            event.preventDefault()
            error.textContent = ''

            const attempt = await fetch(
              `${api}/scenes/public/${encodeURIComponent(slug)}/unlock`,
              {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: input.value }),
              },
            )

            if (attempt.ok) {
              const body = await attempt.json()
              gate.hidden = true
              els.status.classList.remove('gone')
              resolve(body.scene)
              return
            }

            // 429 carries its own message about waiting, which is more useful
            // than a generic "wrong code" when the reason is a lockout.
            const body = await attempt.json().catch(() => ({}))
            error.textContent = body.message ?? 'That code did not work.'
            input.select()
          })
        })
      }

      async function main() {
        const slug = slugFromLocation()
        if (!slug) return fail('No walkthrough specified', 'This link is missing its scene.')

        const response = await fetch(`${api}/scenes/public/${encodeURIComponent(slug)}`)
        if (!response.ok) {
          return fail(
            'Walkthrough not found',
            'The link may be wrong, or the scene may have been unpublished.',
          )
        }

        let { scene } = await response.json()

        // ---- Gated scenes ---------------------------------------------------
        // A protected scene arrives with its name and nothing that renders it,
        // so there is nothing to show until a code is exchanged. The name is
        // displayed: a visitor needs to know they are in the right place before
        // being asked for a credential.
        if (scene.protected) {
          scene = await unlock(slug, scene.name)
          if (!scene) return
        }

        document.title = scene.name ? `${scene.name} — Walkthrough` : 'Walkthrough'
        els.name.textContent = scene.name ?? 'Walkthrough'

        if (!scene.modelUrl) {
          return fail('Nothing to show yet', 'This scene was published before it had any geometry.')
        }

        const viewer = new SceneViewer({
          canvas: document.getElementById('canvas'),
          onProgress: (fraction) => {
            els.bar.style.width = `${Math.round(fraction * 100)}%`
            els.detail.textContent = 'Loading the model…'
          },
          onError: (error) => fail('Could not load the walkthrough', error.message),
        })

        await viewer.loadModel(absolute(scene.modelUrl))

        // The bake, if there is one. Applied before the first frame is shown, so
        // the client never sees the flat version and then a jump.
        //
        // One call into the shared viewer rather than the material walk this
        // page used to do inline — that duplicate had a bug the studio's copy
        // did not, and rendered an empty sky. See applyBakedLightmap.
        if (scene.bakedUrl) {
          els.detail.textContent = 'Loading the lighting…'
          // A missing or unreadable atlas is a flatter room, not a broken page.
          const lit = await viewer.applyBakedLightmap(absolute(scene.bakedUrl)).catch(() => 0)
          if (lit === 0) console.warn('The bake did not apply; showing real-time lighting.')
        }

        viewer.frameModel()

        const walk = new WalkController(viewer, document.getElementById('canvas'), {
          eyeHeight: 1.6,
          speed: 2.68,
        })

        let walking = false
        els.walk.addEventListener('click', () => {
          walking = !walking
          els.walk.setAttribute('aria-pressed', String(walking))
          els.walk.textContent = walking ? 'Leave walkthrough' : 'Walk through it'
          if (walking) {
            // Stand inside before enabling, or the visitor enters the
            // walkthrough in the garden looking at the building.
            viewer.standInside(1.6)
            // Wider inside than out, and brisker than a real walking pace: at
            // 50 degrees a small room fills the screen with one wall, and at
            // 2.7 m/s a client spends the tour stopping and turning.
            viewer.setFieldOfView(72)
            walk.setSpeed(4.5)
            walk.enable()
          } else {
            walk.disable()
            viewer.setFieldOfView(50)
            viewer.frameModel()
          }
        })

        els.fit.addEventListener('click', () => {
          if (walking) els.walk.click()
          else viewer.frameModel()
        })

        // ---- Branding -------------------------------------------------------
        // Applied before anything is shown, so a client never sees Arcvia blue
        // flash to the developer's colour.
        const branding = scene.branding ?? {}
        if (branding.accent) document.documentElement.style.setProperty('--accent', branding.accent)
        if (branding.logoUrl) {
          const logo = document.createElement('img')
          logo.id = 'logo'
          logo.src = absolute(branding.logoUrl)
          logo.alt = scene.name ?? ''
          els.name.replaceWith(logo)
        }
        if (branding.hideCredit) document.getElementById('brand')?.remove()

        // ---- Named views ----------------------------------------------------
        const views = scene.views ?? []
        if (views.length > 0) {
          els.views.hidden = false
          for (const view of views) {
            const button = document.createElement('button')
            button.textContent = view.name
            button.addEventListener('click', () => {
              // Leave first-person before jumping: arriving at a named view
              // still in walk mode drops the visitor there with the pointer
              // locked, which reads as the view having failed.
              if (walking) els.walk.click()
              viewer.goToView(view)
            })
            els.views.appendChild(button)
          }
          // Open on the first view rather than an overview. It is the shot the
          // author chose to lead with, and an overview of a single flat is
          // rarely the most flattering thing to open on.
          viewer.goToView(views[0], false)
        }

        // ---- Hotspots -------------------------------------------------------
        const hotspots = scene.hotspots ?? []
        const markers = hotspots.map((hotspot) => {
          const marker = document.createElement('div')
          marker.className = 'spot'
          marker.dataset.open = 'false'

          const dot = document.createElement('button')
          dot.type = 'button'
          dot.textContent = '+'
          dot.setAttribute('aria-label', hotspot.title)

          const card = document.createElement('div')
          card.className = 'card'
          const title = document.createElement('strong')
          title.textContent = hotspot.title
          card.appendChild(title)
          if (hotspot.body) {
            const body = document.createElement('span')
            body.textContent = hotspot.body
            card.appendChild(body)
          }
          if (hotspot.link) {
            const link = document.createElement('a')
            link.href = hotspot.link
            link.target = '_blank'
            link.rel = 'noreferrer noopener'
            link.textContent = 'More'
            card.appendChild(document.createElement('br'))
            card.appendChild(link)
          }

          dot.addEventListener('click', () => {
            const open = marker.dataset.open === 'true'
            // One card at a time: two overlapping cards in a small room is
            // unreadable, and the second click is almost always "show me that
            // one instead".
            for (const other of markers) other.el.dataset.open = 'false'
            marker.dataset.open = String(!open)
            dot.textContent = !open ? '×' : '+'
          })

          marker.append(dot, card)
          els.spots.appendChild(marker)
          return { el: marker, hotspot, dot }
        })

        // Positioned after every draw. Markers track the geometry they label,
        // so they have to be recomputed whenever the camera moves at all.
        if (markers.length > 0) {
          viewer.onAfterRender = () => {
            for (const { el, hotspot } of markers) {
              const at = viewer.project(hotspot.position)
              el.style.display = at.visible ? '' : 'none'
              if (!at.visible) continue
              el.style.left = at.x + 'px'
              el.style.top = at.y + 'px'
              // Fade with distance rather than hiding: a marker that vanishes
              // as you back away looks broken, one that recedes looks placed.
              el.style.opacity = String(Math.max(0.35, Math.min(1, 12 / at.distance)))
            }
          }
        }

        // Attribution. Present when it is owed, absent when it is not.
        const credits = scene.credits ?? []
        if (credits.length > 0) {
          els.creditsToggle.hidden = false
          els.creditList.innerHTML = credits
            .map(
              (credit) =>
                `<li><a href="${credit.source}" target="_blank" rel="noreferrer">${credit.author}</a>` +
                `<span class="lic"> — ${credit.licence}</span></li>`,
            )
            .join('')
          els.creditsToggle.addEventListener('click', () => {
            const open = els.credits.hasAttribute('hidden')
            els.credits.toggleAttribute('hidden', !open)
            els.creditsToggle.setAttribute('aria-pressed', String(open))
          })
        }

        els.status.classList.add('gone')
        els.controls.hidden = false
      }

      main().catch((error) =>
        fail('Something went wrong', error?.message ?? 'The walkthrough could not be opened.'),
      )
    </script>
  </body>
</html>
