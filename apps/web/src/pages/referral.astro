---
import brand from '@arcvia/brand'
import plans from '@arcvia/brand/plans'
import Base from '../layouts/Base.astro'
import ReferralDashboard from '../components/ReferralDashboard.tsx'
import FaqAccordion from '../components/FaqAccordion.tsx'
import { referralFaqs } from '../data/faqs'

const steps = [
  { n: 1, title: 'Have an account', body: `Any ${brand.name} account has a code from the day it is created.` },
  { n: 2, title: 'Share your link', body: 'The link prefills the code, so the person you referred does nothing extra.' },
  { n: 3, title: 'They sign up', body: 'The referral is recorded at the moment the account is created.' },
  { n: 4, title: 'You get credited', body: 'Recorded now; paid as a share of their subscription once billing starts.' },
]

const why = [
  'You help peers close clients faster',
  'You strengthen your professional network',
  'You earn without selling — we handle onboarding',
  'You get a better-tooled industry to work in',
]
---

<Base
  title="Referral programme"
  description={`Refer another practice to ${brand.name} and earn a recurring share of their subscription.`}
>
  <section class="border-b border-line py-section">
    <div class="shell max-w-3xl">
      <p class="eyebrow">Referrals</p>
      <h1 class="h1 mt-4 text-balance">Refer a practice. Earn on it, monthly.</h1>
      <p class="lede mt-5 text-pretty">
        {
          plans.billingEnabled
            ? 'Ten percent of every referred subscription, paid monthly, with no cap and no expiry.'
            : `${brand.name} is free today, so there is nothing to take a percentage of yet — but every referral is being recorded from now, and the rate below is what it will pay when billing starts.`
        }
      </p>

      <dl class="mt-10 grid gap-5 sm:grid-cols-3">
        <div class="card">
          <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">
            Rate
          </dt>
          <dd class="mt-2 text-2xl font-semibold tracking-tight">10%</dd>
          <p class="hint">Of each referred subscription</p>
        </div>
        <div class="card">
          <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">
            Frequency
          </dt>
          <dd class="mt-2 text-2xl font-semibold tracking-tight">Monthly</dd>
          <p class="hint">For as long as they stay</p>
        </div>
        <div class="card">
          <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-ink-soft">
            Cap
          </dt>
          <dd class="mt-2 text-2xl font-semibold tracking-tight">None</dd>
          <p class="hint">No limit on referrals or earnings</p>
        </div>
      </dl>
    </div>
  </section>

  <!-- ── Dashboard ───────────────────────────────────────────────────────── -->
  <section class="py-section">
    <div class="shell max-w-3xl">
      <h2 class="h2 text-balance">Your dashboard</h2>
      <p class="mt-3 leading-relaxed text-ink-soft">
        Your code, your link, and everyone who has joined through it.
      </p>

      <div class="mt-8">
        <!-- client:only because the whole thing depends on a session that
             cannot exist at build time. See AccountMenu.tsx. -->
        <ReferralDashboard client:only="react" />
      </div>
    </div>
  </section>

  <!-- ── How it works ────────────────────────────────────────────────────── -->
  <section class="bg-surface-alt py-section">
    <div class="shell">
      <p class="eyebrow">How it works</p>
      <h2 class="h2 mt-3">Four steps, and you only do one of them</h2>

      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s) => (
            <li class="card bg-surface">
              <span class="grid h-7 w-7 place-items-center rounded-lg bg-accent text-sm font-bold text-white">
                {s.n}
              </span>
              <h3 class="h3 mt-3">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{s.body}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-12 grid gap-8 lg:grid-cols-2">
        <div>
          <h3 class="h3">Why practices refer</h3>
          <ul class="mt-4 space-y-2.5">
            {
              why.map((w) => (
                <li class="flex items-start gap-2.5 text-sm text-ink-soft">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                  {w}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card bg-surface">
          <h3 class="h3">What counts as a referral</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">
            A new organisation that signs up with your code and is not already a
            customer. Referring yourself, or a second account at your own
            organisation, does not count — the system checks for it and quietly
            declines to credit it.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">
            An unrecognised code never blocks a signup. It is simply not
            credited.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ─────────────────────────────────────────────────────────────── -->
  <section class="pb-section pt-section">
    <div class="shell max-w-3xl">
      <p class="eyebrow">FAQs</p>
      <h2 class="h2 mt-3">Referral questions</h2>
      <FaqAccordion client:visible items={referralFaqs} initialOpen={null} />
    </div>
  </section>
</Base>
