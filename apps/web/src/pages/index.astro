---
import brand from '@arcvia/brand'
import Base from '../layouts/Base.astro'
import FaqAccordion from '../components/FaqAccordion.tsx'
import { faqs } from '../data/faqs'

const steps = [
  {
    n: '01',
    title: 'Upload your drawings',
    body: 'CAD, SketchUp, Revit exports, PDF, JPG or PNG. Our detector reads the plan and finds walls, doors, windows and fixtures automatically.',
  },
  {
    n: '02',
    title: 'Customise the space',
    body: 'Place furniture, set materials and paint, and light the scene. Everything happens live in the browser — no software to install.',
  },
  {
    n: '03',
    title: 'Share a link',
    body: 'Publish once and send a single URL. Clients explore on desktop, phone or a VR headset, and can reconfigure the space themselves.',
  },
]

const features = [
  {
    title: 'Show the finest details',
    body: 'Let clients walk through a building before ground is broken, and personalise the interior as they go. Every room, explorable as though they were standing in it.',
  },
  {
    title: 'Runs on every device',
    body: 'Works alongside the architectural software you already use, and plays back on anything with a browser — including phones and VR headsets.',
  },
  {
    title: 'Unlimited stills and flythroughs',
    body: 'Need print-quality renders, panoramas or a video walkthrough alongside the interactive tour? Queue as many as you like.',
  },
  {
    title: 'A design tool and a sales tool',
    body: 'One asset serves the design review, the client presentation and the marketing campaign. Build it once, use it everywhere.',
  },
]
---

<Base>
  <!-- ── Hero ────────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden border-b border-line">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-gradient-to-b from-accent-soft to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="shell relative py-20 text-center sm:py-28">
      <p class="eyebrow">Free while in beta</p>
      <h1 class="h1 mx-auto mt-4 max-w-3xl text-balance">
        {brand.tagline}
      </h1>
      <p class="lede mx-auto mt-5 max-w-2xl text-pretty">
        {brand.description}
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href="/register/" class="btn-primary">Start building — free</a>
        <a href="#how-it-works" class="btn-secondary">See how it works</a>
      </div>

      <p class="mt-4 text-xs text-ink-soft">
        No card required. No trial clock.
      </p>

      <!-- Aspect box reserved up front so the hero never shifts when the media
           finishes loading — a real Core Web Vitals win, not decoration. -->
      <div
        class="mx-auto mt-14 aspect-video w-full max-w-4xl overflow-hidden rounded-card border border-line bg-surface-alt shadow-sm"
      >
        <div class="grid h-full place-items-center text-sm text-ink-soft">
          Product walkthrough
        </div>
      </div>
    </div>
  </section>

  <!-- ── How it works ────────────────────────────────────────────────────── -->
  <section id="how-it-works" class="scroll-mt-24 py-section">
    <div class="shell">
      <p class="eyebrow">How it works</p>
      <h2 class="h2 mt-3 max-w-2xl text-balance">
        From a flat drawing to a walkthrough in three steps
      </h2>

      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {
          steps.map((s) => (
            <li class="card">
              <span class="font-mono text-sm text-accent">{s.n}</span>
              <h3 class="h3 mt-3">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ── Features ────────────────────────────────────────────────────────── -->
  <section id="features" class="scroll-mt-24 bg-surface-alt py-section">
    <div class="shell">
      <p class="eyebrow">Why teams use {brand.name}</p>
      <h2 class="h2 mt-3 max-w-2xl text-balance">
        Built for the moment a client says “I can’t picture it”
      </h2>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          features.map((f) => (
            <article class="card bg-surface">
              <h3 class="h3">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Enterprise teaser ───────────────────────────────────────────────── -->
  <section id="enterprise" class="scroll-mt-24 py-section">
    <div class="shell">
      <div class="rounded-card bg-ink px-8 py-14 text-white sm:px-14">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
          For enterprise
        </p>
        <h2 class="h2 mt-3 max-w-2xl text-balance">
          Projects don’t stall because the design is bad. They stall because
          people read the drawings differently.
        </h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-white/70">
          Multiple architects, one live model. Standardised output across teams,
          cities and projects — with automated BOQ and BOM so the numbers match
          the drawing.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/enterprise/" class="btn-primary">Explore enterprise</a>
          <a
            href="/contact/"
            class="btn border border-white/25 text-white hover:bg-white/10"
            >Book a demo</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ─────────────────────────────────────────────────────────────── -->
  <section id="faq" class="scroll-mt-24 pb-section">
    <div class="shell max-w-3xl">
      <p class="eyebrow">FAQs</p>
      <h2 class="h2 mt-3">Frequently asked questions</h2>

      <!-- The only island on this page. `client:visible` means the JS is not
           fetched at all until the reader scrolls this far down. -->
      <FaqAccordion client:visible items={faqs} />
    </div>
  </section>
</Base>
