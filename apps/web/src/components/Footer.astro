---
import brand from '@arcvia/brand'

const year = new Date().getFullYear()

const columns = [
  {
    heading: 'Product',
    links: [
      { label: 'How it works', href: '/#how-it-works' },
      { label: 'Services', href: '/services/' },
      { label: 'Pricing', href: '/pricing/' },
      { label: 'Enterprise', href: '/enterprise/' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { label: 'About us', href: '/about/' },
      { label: 'Contact us', href: '/contact/' },
      { label: 'Referral programme', href: '/referral/' },
    ],
  },
  // Account routes live in the footer as well as the header menu. The menu is
  // a client-only island, so these are the only links to them that exist in
  // the static HTML — which is what a crawler, a text browser, and anyone
  // whose JavaScript failed to load actually sees.
  {
    heading: 'Account',
    links: [
      { label: 'Sign in', href: '/login/' },
      { label: 'Create an account', href: '/register/' },
      { label: 'Getting started', href: '/trial/' },
      { label: 'Reset password', href: '/reset-password/' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { label: 'Privacy policy', href: '/privacy/' },
      { label: 'Terms & conditions', href: '/terms/' },
      { label: 'Refund policy', href: '/refund/' },
    ],
  },
]
---

<footer class="mt-section border-t border-line bg-surface-alt">
  <div class="shell grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
    <div>
      <div class="flex items-center gap-2 font-semibold tracking-tight">
        <span
          class="grid h-8 w-8 place-items-center rounded-lg bg-accent text-sm font-bold text-white"
          aria-hidden="true">{brand.name.charAt(0)}</span
        >
        <span>{brand.name}</span>
      </div>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-soft">
        {brand.tagline}
      </p>
    </div>

    {
      columns.map((col) => (
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-[0.12em] text-ink">
            {col.heading}
          </h2>
          <ul class="mt-3 space-y-2">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-sm text-ink-soft transition-colors hover:text-ink"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="border-t border-line">
    <div
      class="shell flex flex-col gap-2 py-5 text-xs text-ink-soft sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {brand.legalName}</p>
      <p>Made for architects, developers and construction teams.</p>
    </div>
  </div>
</footer>
