---
import brand from '@arcvia/brand'
import Base from '../layouts/Base.astro'
import { plans, formatCredits } from '@arcvia/brand/plans'

const free = plans.free
---

<Base
  title="Create your account"
  description={`Create a free ${brand.name} account. No card required.`}
>
  <section class="shell grid min-h-[70vh] max-w-5xl items-center gap-14 py-16 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Free while in beta</p>
      <h1 class="h2 mt-3 text-balance">Create your account</h1>
      <p class="lede mt-4 text-pretty">
        Full access to the studio, the configurator and GPU renders. No card, no
        trial clock, nothing to cancel.
      </p>

      <ul class="mt-8 space-y-3 text-sm text-ink-soft">
        {
          [
            'Unlimited projects and storage',
            `Invite up to ${free.seats} team members`,
            `${formatCredits(free)} render credits per member each month`,
            'Export your models and stills at any time',
          ].map((f) => (
            <li class="flex items-start gap-2.5">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
              {f}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="card">
      <form id="register-form" novalidate class="space-y-4">
        <div>
          <label for="name" class="mb-1.5 block text-sm font-medium">Full name</label>
          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            required
            class="w-full rounded-lg border border-line px-3.5 py-2.5 text-sm outline-none focus:border-accent"
          />
        </div>

        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium">Work email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            class="w-full rounded-lg border border-line px-3.5 py-2.5 text-sm outline-none focus:border-accent"
          />
        </div>

        <div>
          <label for="organisation" class="mb-1.5 block text-sm font-medium"
            >Practice or company</label
          >
          <input
            id="organisation"
            name="organisation"
            type="text"
            autocomplete="organization"
            required
            class="w-full rounded-lg border border-line px-3.5 py-2.5 text-sm outline-none focus:border-accent"
          />
        </div>

        <div>
          <label for="phone" class="mb-1.5 block text-sm font-medium">Mobile</label>
          <div class="flex gap-2">
            <span
              class="grid shrink-0 place-items-center rounded-lg border border-line px-3 text-sm text-ink-soft"
              >+91</span
            >
            <input
              id="phone"
              name="phone"
              type="tel"
              inputmode="numeric"
              autocomplete="tel-national"
              maxlength="10"
              required
              class="w-full rounded-lg border border-line px-3.5 py-2.5 text-sm outline-none focus:border-accent"
            />
          </div>
          <p class="mt-1.5 text-xs text-ink-soft">
            We send a one-time code to verify it.
          </p>
        </div>

        <div>
          <label for="password" class="mb-1.5 block text-sm font-medium">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="new-password"
            minlength="8"
            required
            class="w-full rounded-lg border border-line px-3.5 py-2.5 text-sm outline-none focus:border-accent"
          />
        </div>

        <div>
          <label for="referralCode" class="mb-1.5 block text-sm font-medium">
            Referral code <span class="font-normal text-ink-soft">(optional)</span>
          </label>
          <input
            id="referralCode"
            name="referralCode"
            type="text"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            maxlength="12"
            class="field font-mono uppercase tracking-wider"
          />
          <!-- Confirmed live as the field is filled, so a mistyped code is
               caught while it can still be corrected. Once the account exists
               the referral cannot be attached retroactively. -->
          <p id="referral-status" class="hint" aria-live="polite"></p>
        </div>

        <p
          id="form-error"
          role="alert"
          class="hidden rounded-lg bg-danger/10 px-3.5 py-2.5 text-sm text-danger"
        >
        </p>

        <button type="submit" id="submit" class="btn-primary w-full">
          Create account
        </button>

        <p class="text-center text-sm text-ink-soft">
          Already have an account?
          <a href="/login/" class="font-medium text-accent hover:underline">
            Sign in
          </a>
        </p>

        <p class="text-center text-xs leading-relaxed text-ink-soft">
          By continuing you agree to our
          <a href="/terms/" class="underline">terms</a> and
          <a href="/privacy/" class="underline">privacy policy</a>.
        </p>
      </form>
    </div>
  </section>
</Base>

<script>
  import { register } from '../lib/auth'
  import { validateReferralCode } from '../lib/account'

  const form = document.getElementById('register-form') as HTMLFormElement | null
  const errorBox = document.getElementById('form-error') as HTMLElement | null
  const submit = document.getElementById('submit') as HTMLButtonElement | null
  const refInput = document.getElementById('referralCode') as HTMLInputElement | null
  const refStatus = document.getElementById('referral-status') as HTMLElement | null

  function showError(message: string) {
    if (!errorBox) return
    errorBox.textContent = message
    errorBox.classList.remove('hidden')
  }

  // ---- Referral code -------------------------------------------------------

  // A shared link arrives as /register/?ref=CODE. Prefilling it means the
  // person who was referred never has to notice the code exists.
  const fromUrl = new URLSearchParams(location.search).get('ref')
  if (fromUrl && refInput) {
    refInput.value = fromUrl.toUpperCase()
    void checkReferral()
  }

  let refTimer: ReturnType<typeof setTimeout> | undefined

  refInput?.addEventListener('input', () => {
    if (refStatus) refStatus.textContent = ''
    clearTimeout(refTimer)
    // Debounced: this fires per keystroke otherwise, and an 8-character code
    // would produce eight requests, seven of which are known-invalid prefixes.
    refTimer = setTimeout(checkReferral, 400)
  })

  async function checkReferral() {
    const code = refInput?.value.trim().toUpperCase() ?? ''
    if (!refStatus) return
    if (!code) {
      refStatus.textContent = ''
      refStatus.className = 'hint'
      return
    }

    try {
      const result = await validateReferralCode(code)
      if (result.valid) {
        refStatus.textContent = `Referred by ${result.organisation}.`
        refStatus.className = 'hint !text-signal'
      } else {
        refStatus.textContent = "We don't recognise that code — you can still continue."
        refStatus.className = 'hint !text-warn'
      }
    } catch {
      // A lookup failure is not the user's problem and must not read like a
      // rejection: the code is still sent, and the server decides.
      refStatus.textContent = ''
      refStatus.className = 'hint'
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    errorBox?.classList.add('hidden')

    const data = new FormData(form)
    const payload = {
      name: String(data.get('name') ?? '').trim(),
      email: String(data.get('email') ?? '').trim().toLowerCase(),
      organisation: String(data.get('organisation') ?? '').trim(),
      phone: String(data.get('phone') ?? '').trim(),
      password: String(data.get('password') ?? ''),
      referralCode:
        String(data.get('referralCode') ?? '').trim().toUpperCase() || undefined,
    }

    if (payload.password.length < 8) {
      showError('Password must be at least 8 characters.')
      return
    }
    if (!/^\d{10}$/.test(payload.phone)) {
      showError('Enter a 10-digit mobile number.')
      return
    }

    if (submit) {
      submit.disabled = true
      submit.textContent = 'Creating account…'
    }

    try {
      await register(payload)
      window.location.href = '/verify/'
    } catch (err) {
      showError(err instanceof Error ? err.message : 'Something went wrong.')
      if (submit) {
        submit.disabled = false
        submit.textContent = 'Create account'
      }
    }
  })
</script>
