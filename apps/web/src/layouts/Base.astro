---
import brand from '@arcvia/brand'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { isIndexable } from '../lib/routes.mjs'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  /**
   * Force a page out of the index.
   *
   * Normally you do not pass this: the answer comes from `lib/routes.ts`,
   * which the sitemap reads too, so the meta tag and the sitemap cannot
   * disagree. Pass it only for a page whose privacy depends on something this
   * URL cannot express.
   */
  noindex?: boolean
}

const {
  title,
  description = brand.description,
  noindex: noindexOverride = false,
} = Astro.props

// The route policy decides, unless a page insists. Deriving it here is what
// stops the sitemap and the meta tag drifting apart — before this, seven pages
// said `noindex` while the sitemap submitted them for indexing.
const noindex = noindexOverride || !isIndexable(Astro.url.pathname)

const pageTitle = title ? `${title} — ${brand.name}` : brand.name
const canonical = new URL(Astro.url.pathname, Astro.site).href

// Analytics IDs come from the environment, never from source. A fork of this
// repo therefore reports into nobody's account until it is configured.
const gaId = import.meta.env.PUBLIC_GA_ID ?? ''
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/*
      `summary_large_image` was declared here with no `og:image` anywhere on the
      site — a card promising a large image and supplying none. See og.png.ts.
      An absolute URL is required: crawlers do not resolve relative paths.
    */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${brand.name} — ${brand.description}`} />
    <meta property="og:site_name" content={brand.name} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || []
            function gtag() {
              dataLayer.push(arguments)
            }
            gtag('js', new Date())
            gtag('config', gaId)
          </script>
        </>
      )
    }
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
