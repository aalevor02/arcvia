---
import brand from '@arcvia/brand'
import Base from '../layouts/Base.astro'
---

<Base
  title="Reset your password"
  description={`Reset the password on your ${brand.name} account.`}
  noindex
>
  <section class="shell flex min-h-[70vh] max-w-md flex-col justify-center py-16">
    <!-- ── Step 1: ask for the email ─────────────────────────────────────── -->
    <div id="request-step">
      <h1 class="h2 text-balance">Reset your password</h1>
      <p class="lede mt-3">
        Enter the address on your account and we'll send you a link.
      </p>

      <form id="request-form" novalidate class="card mt-8 space-y-4">
        <div>
          <label for="email" class="label">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="you@practice.com"
            class="field"
          />
        </div>

        <p id="request-error" role="alert" class="alert-error hidden"></p>

        <button type="submit" id="request-submit" class="btn-primary w-full">
          Send reset link
        </button>
      </form>
    </div>

    <!-- ── Step 1b: sent ─────────────────────────────────────────────────── -->
    <div id="sent-step" class="hidden">
      <h1 class="h2 text-balance">Check your inbox</h1>
      <p class="lede mt-3" id="sent-message"></p>
      <div id="dev-link-box" class="alert-info mt-6 hidden">
        <p class="font-medium text-ink">Development mode</p>
        <p class="mt-1">
          No mail provider is configured, so the link is below instead of in an
          inbox.
        </p>
        <a id="dev-link" href="#" class="mt-2 block break-all text-accent underline"
        ></a>
      </div>
      <a href="/login/" class="btn-secondary mt-8 w-full">Back to sign in</a>
    </div>

    <!-- ── Step 2: set the new password (?token=…) ───────────────────────── -->
    <div id="set-step" class="hidden">
      <h1 class="h2 text-balance">Choose a new password</h1>
      <p class="lede mt-3">
        You'll be signed in as soon as it's saved.
      </p>

      <form id="set-form" novalidate class="card mt-8 space-y-4">
        <div>
          <label for="password" class="label">New password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="new-password"
            minlength="8"
            required
            class="field"
          />
          <p class="hint">At least 8 characters.</p>
        </div>

        <div>
          <label for="confirm" class="label">Confirm password</label>
          <input
            id="confirm"
            name="confirm"
            type="password"
            autocomplete="new-password"
            required
            class="field"
          />
        </div>

        <p id="set-error" role="alert" class="alert-error hidden"></p>

        <button type="submit" id="set-submit" class="btn-primary w-full">
          Save and sign in
        </button>
      </form>
    </div>
  </section>
</Base>

<script>
  import { requestPasswordReset, resetPassword } from '../lib/auth'
  import { openStudioUrl } from '../lib/links'

  const $ = (id: string) => document.getElementById(id)

  const token = new URLSearchParams(location.search).get('token')

  // One page, two jobs, chosen by whether a token is present in the URL. The
  // reference product uses two separate pages for this; one page means the
  // link in the email lands somewhere that already knows what to do with it,
  // rather than bouncing through a redirect.
  if (token) {
    $('request-step')?.classList.add('hidden')
    $('set-step')?.classList.remove('hidden')
  }

  function show(el: HTMLElement | null, message: string) {
    if (!el) return
    el.textContent = message
    el.classList.remove('hidden')
  }

  // ---- Step 1 --------------------------------------------------------------
  const requestForm = $('request-form') as HTMLFormElement | null
  const requestSubmit = $('request-submit') as HTMLButtonElement | null

  requestForm?.addEventListener('submit', async (event) => {
    event.preventDefault()
    $('request-error')?.classList.add('hidden')

    const email = String(new FormData(requestForm).get('email') ?? '')
      .trim()
      .toLowerCase()

    if (!email) {
      show($('request-error'), 'Enter your email address.')
      return
    }

    if (requestSubmit) {
      requestSubmit.disabled = true
      requestSubmit.textContent = 'Sending…'
    }

    try {
      const result = await requestPasswordReset(email)

      $('request-step')?.classList.add('hidden')
      $('sent-step')?.classList.remove('hidden')
      show($('sent-message'), result.message)

      // Development convenience only: the API returns the token when no mail
      // provider is configured, so the flow is testable without SMTP.
      if (result.devToken) {
        const link = $('dev-link') as HTMLAnchorElement | null
        const href = `/reset-password/?token=${result.devToken}`
        if (link) {
          link.href = href
          link.textContent = href
        }
        $('dev-link-box')?.classList.remove('hidden')
      }
    } catch (err) {
      show(
        $('request-error'),
        err instanceof Error ? err.message : 'Something went wrong.',
      )
      if (requestSubmit) {
        requestSubmit.disabled = false
        requestSubmit.textContent = 'Send reset link'
      }
    }
  })

  // ---- Step 2 --------------------------------------------------------------
  const setForm = $('set-form') as HTMLFormElement | null
  const setSubmit = $('set-submit') as HTMLButtonElement | null

  setForm?.addEventListener('submit', async (event) => {
    event.preventDefault()
    $('set-error')?.classList.add('hidden')

    const data = new FormData(setForm)
    const password = String(data.get('password') ?? '')
    const confirm = String(data.get('confirm') ?? '')

    if (password.length < 8) {
      show($('set-error'), 'Password must be at least 8 characters.')
      return
    }
    // Checked here as well as being an obvious UX nicety: a mistyped new
    // password on a reset flow locks someone out of their own account, and the
    // server cannot catch it because both fields look equally valid to it.
    if (password !== confirm) {
      show($('set-error'), 'Those two passwords do not match.')
      return
    }

    if (setSubmit) {
      setSubmit.disabled = true
      setSubmit.textContent = 'Saving…'
    }

    try {
      await resetPassword(token!, password)
      window.location.href = openStudioUrl()
    } catch (err) {
      show(
        $('set-error'),
        err instanceof Error ? err.message : 'Something went wrong.',
      )
      if (setSubmit) {
        setSubmit.disabled = false
        setSubmit.textContent = 'Save and sign in'
      }
    }
  })
</script>
