{
  "name": "arcvia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Real-estate visualisation platform — marketing site, 3D studio, render pipeline.",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/studio",
    "apps/planviewer",
    "apps/visualisation",
    "services/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:studio": "npm run dev --workspace=apps/studio",
    "dev:plan": "npm run dev --workspace=apps/planviewer",
    "dev:vis": "npm run dev --workspace=apps/visualisation",
    "dev:api": "npm run dev --workspace=services/api",
    "dev:detect": "powershell -ExecutionPolicy Bypass -File tools/dev-detect.ps1",
    "check:types": "node tools/validate.mjs types",
    "test:js": "node tools/validate.mjs js",
    "test:python": "node tools/validate.mjs python",
    "test:bim": "node tools/validate.mjs bim",
    "compare:trees": "node tools/compare-trees.mjs A:\\Web\\Arcvia C:\\Users\\aalev\\Arcvia",
    "build": "npm run build --workspaces --if-present",
    "build:production": "node tools/validate.mjs build",
    "validate": "node tools/validate.mjs all"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  }
}
