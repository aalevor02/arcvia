{
  "name": "arcvia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Real-estate visualisation platform — marketing site, 3D studio, render pipeline.",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/studio",
    "apps/planviewer",
    "apps/visualisation",
    "services/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:studio": "npm run dev --workspace=apps/studio",
    "dev:plan": "npm run dev --workspace=apps/planviewer",
    "dev:vis": "npm run dev --workspace=apps/visualisation",
    "dev:api": "npm run dev --workspace=services/api",
    "dev:detect": "services/floorplan-ai/.venv/Scripts/python.exe -m uvicorn main:app --host 127.0.0.1 --port 8090 --app-dir services/floorplan-ai",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  }
}
