# ============================================================================
# Arcvia — copy to .env and fill in. Nothing here is required to run locally;
# every value has a working development default.
# ============================================================================

# ---- API --------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Where the marketing site is served from. The API pastes this into links it
# hands out — referral links and password-reset links — so if it is wrong those
# links point at the API, which serves no pages. In development it is inferred
# from the request Origin; in production SET IT.
PUBLIC_SITE_URL=

# MUST be set in production — the server refuses to start without it there.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL=12h

# JSON file store. Swap services/api/src/store.js for a Mongo driver when you
# outgrow this; nothing else in the codebase touches persistence.
DB_PATH=./.data/db.json

# ---- Render pipeline --------------------------------------------------------
# local  = spawn Blender on this machine (free, use for development)
# remote = POST to a GPU worker pool (this is the one that costs money)
RENDER_MODE=local

BLENDER_PATH=C:/Program Files/Blender Foundation/Blender 5.1/blender.exe
# BLENDER_SCRIPT is intentionally NOT set here. The default is resolved
# relative to the API source, so it is correct from every start directory; a
# cwd-relative override like the old default was wrong the moment the API was
# started from anywhere but the repo root. Set this only to point at a render
# script somewhere other than services/render-worker/render.py.
ARCVIA_OUT_DIR=./.data/renders

# ---- Cost guards ------------------------------------------------------------
# Concurrency x GPU hourly rate = your worst-case burn rate. Raise deliberately.
RENDER_CONCURRENCY=1
# Hard ceiling per job. A runaway scene cannot bill for hours.
RENDER_TIMEOUT_MS=600000
# Install-wide circuit breaker. Jobs past the cap queue rather than fail.
RENDER_DAILY_CAP=500

# Only needed when RENDER_MODE=remote
RENDER_WORKER_URL=
WORKER_SECRET=

# ---- Floor-plan detection ---------------------------------------------------
FLOORPLAN_URL=http://localhost:8090
FLOORPLAN_BACKEND=heuristic
FLOORPLAN_MODEL=
# Vision adjudication is optional and server-only; never expose these to the browser.
# It powers two things off one client (see design.py:92): the adjudicator that
# second-guesses the heuristic's room/wall proposals, and the deck design reader.
#
# "auto" prefers NVIDIA when NVIDIA_API_KEY is present, which is the free path
# and the one this repo is developed against. Set OPENAI_API_KEY *and no NVIDIA
# key* to use OpenAI instead. Both are read from the floorplan-ai process
# environment, never from frontend code.
FLOORPLAN_AI_PROVIDER=openai
NVIDIA_API_KEY=
# Pin the vision model explicitly. A hosted model can be retired underneath you:
# nvidia/nemotron-nano-12b-v2-vl reached end of life on 2026-08-26 and began
# returning HTTP 410, and because adjudicate.py fails open, every call was
# silently recorded as "went unanswered" instead of raising. If the adjudicator
# stops changing anything, check this first.
FLOORPLAN_ADJUDICATOR_MODEL=meta/llama-3.2-11b-vision-instruct
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.5
# Optional OpenAI-compatible endpoint override.
FLOORPLAN_ADJUDICATOR_URL=

# ---- File storage -----------------------------------------------------------
# Where uploaded floor-plan images are written, and the URL prefix they are
# served under. Local disk is the development driver; in production these are
# replaced by a bucket and a CDN, and the API stops carrying the bytes at all.
# See services/api/src/lib/storage.js.
UPLOAD_DIR=./.data/uploads
UPLOAD_PUBLIC_PREFIX=/uploads

# ---- Outbound integrations (all optional) -----------------------------------
# Leave SMS_PROVIDER empty in development: OTP codes are logged to the console
# instead of sent, so you can test signup without paying per message.
SMS_PROVIDER=
SMS_API_KEY=

# Same idea for email. With MAIL_PROVIDER empty, password-reset links are
# written to the server log and echoed to the browser, so the flow is testable
# without wiring up SMTP first. Both guards are checked before any code is
# echoed, so forgetting NODE_ENV alone cannot leak one.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=

CRM_WEBHOOK_URL=
CRM_TOKEN=

# ---- Frontend (build-time, PUBLIC_ values are exposed to the browser) --------
PUBLIC_API_URL=http://localhost:8787
PUBLIC_GA_ID=
VITE_API_URL=http://localhost:8787

# ---- Billing ----------------------------------------------------------------
# Billing is OFF in packages/brand/plans.config.mjs (billingEnabled = false).
# These stay empty until you flip that flag.
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=

# ---- AI photoreal render ----------------------------------------------------
# BytePlus Ark (Seedream 4.0), chosen 2026-08-27. The previous default was
# Gemini, which sits behind a spend cap on this account. Higgsfield was the
# first choice but has no server-usable credential -- it is an MCP connector
# bound to a Claude account, which a Fastify process cannot reach.
#
# Verified against this key: seedream-4-0-250828 is the only activated image
# model (every seededit/seedream-3.x id returns InvalidEndpointOrModel), it
# accepts image-to-image, and a 2.53 MB data URL is within its input ceiling --
# comfortably more than a viewport capture needs.
#
# This model bills per generated image. RENDER_DAILY_CAP does not apply to it.
AI_IMAGE_PROVIDER=byteplus
AI_IMAGE_KEY=
AI_IMAGE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
AI_IMAGE_MODEL=seedream-4-0-250828
