---
import brand from '@arcvia/brand'
import plans from '@arcvia/brand/plans'
import Base from '../layouts/Base.astro'
import FaqAccordion from '../components/FaqAccordion.tsx'
import HowItWorks from '../components/HowItWorks.tsx'
import HeroVisual from '../components/HeroVisual.astro'
import { faqs } from '../data/faqs'

const features = [
  {
    title: 'Show the finest details',
    body: 'Let clients walk through a building before ground is broken, and personalise the interior as they go. Every room, explorable as though they were standing in it.',
  },
  {
    title: 'Runs on every device',
    body: 'Works alongside the architectural software you already use, and plays back on anything with a browser — including phones and VR headsets.',
  },
  {
    title: 'Unlimited stills and flythroughs',
    body: 'Need print-quality renders, panoramas or a video walkthrough alongside the interactive tour? Queue as many as you like.',
  },
  {
    title: 'A design tool and a sales tool',
    body: 'One asset serves the design review, the client presentation and the marketing campaign. Build it once, use it everywhere.',
  },
]

const collaboration = [
  'Several architects in one model, without overwriting each other',
  'Share progress without a call and a re-explanation',
  'One standardised walkthrough for every presentation',
  'Fewer revision cycles caused by people reading a drawing differently',
]

const integrations = [
  {
    title: 'Ingests what you already export',
    body: 'DWG, DXF, PDF, PNG, JPG and GLB. Nothing changes about how your team draws.',
  },
  {
    title: 'Outputs what marketing already needs',
    body: 'Stills up to 8K, a bill of quantities as a spreadsheet, and a walkthrough as a link.',
  },
  {
    title: 'Runs where you deploy it',
    body: 'Static site, one API, and a render worker you can point at your own GPU. No lock-in to ours.',
  },
]
---

<Base>
  <!-- ── Hero ────────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden border-b border-line">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-[420px] bg-gradient-to-b from-accent-soft to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="shell relative py-20 text-center sm:py-28">
      <p class="eyebrow">Free while in beta</p>
      <h1 class="h1 mx-auto mt-4 max-w-3xl text-balance">
        {brand.tagline}
      </h1>
      <p class="lede mx-auto mt-5 max-w-2xl text-pretty">
        {brand.description}
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href="/register/" class="btn-primary">Start building — free</a>
        <a href="/services/" class="btn-secondary">See a live walkthrough</a>
      </div>

      <p class="mt-4 text-xs text-ink-soft">
        No card required. No trial clock.
      </p>

      <HeroVisual />
    </div>
  </section>

  <!-- ── How it works ────────────────────────────────────────────────────── -->
  <section id="how-it-works" class="scroll-mt-24 py-section">
    <div class="shell">
      <p class="eyebrow">How it works</p>
      <h2 class="h2 mt-3 max-w-2xl text-balance">
        From a flat drawing to a walkthrough in three steps
      </h2>

      <!-- client:visible — the tabs are below the fold on every viewport, so
           the JS is not fetched until someone scrolls to them. -->
      <HowItWorks client:visible />
    </div>
  </section>

  <!-- ── Features ────────────────────────────────────────────────────────── -->
  <section id="features" class="scroll-mt-24 bg-surface-alt py-section">
    <div class="shell">
      <p class="eyebrow">Why teams use {brand.name}</p>
      <h2 class="h2 mt-3 max-w-2xl text-balance">
        Built for the moment a client says “I can’t picture it”
      </h2>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          features.map((f) => (
            <article class="card bg-surface">
              <h3 class="h3">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Collaboration ───────────────────────────────────────────────────── -->
  <section class="py-section">
    <div class="shell grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow">Collaboration</p>
        <h2 class="h2 mt-3 text-balance">
          Projects don’t stall because the design is bad
        </h2>
        <p class="mt-4 leading-relaxed text-ink-soft">
          They stall because people read the drawings differently. A model
          everyone can walk through removes the ambiguity that the drawing set
          leaves behind — before it becomes a revision.
        </p>
        <a href="/enterprise/" class="btn-secondary mt-7">How teams use it</a>
      </div>

      <ul class="space-y-3">
        {
          collaboration.map((c) => (
            <li class="flex items-start gap-3 rounded-card border border-line bg-surface p-4">
              <svg
                width="18" height="18" viewBox="0 0 18 18" fill="none"
                aria-hidden="true" class="mt-0.5 shrink-0 text-accent"
              >
                <path
                  d="M3.5 9.5l3.5 3.5 7.5-8"
                  stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round"
                />
              </svg>
              <span class="text-sm leading-relaxed text-ink-soft">{c}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Integrations ────────────────────────────────────────────────────── -->
  <section class="bg-surface-alt py-section">
    <div class="shell">
      <p class="eyebrow">Fits your workflow</p>
      <h2 class="h2 mt-3 max-w-2xl text-balance">
        Nothing about how your team works has to change
      </h2>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          integrations.map((i) => (
            <article class="card bg-surface">
              <h3 class="h3">{i.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{i.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Enterprise teaser ───────────────────────────────────────────────── -->
  <section id="enterprise" class="scroll-mt-24 py-section">
    <div class="shell">
      <div class="rounded-card bg-ink px-8 py-14 text-white sm:px-14">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
          For enterprise
        </p>
        <h2 class="h2 mt-3 max-w-2xl text-balance">
          Build, present and sell projects faster — at scale
        </h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-white/70">
          Multiple architects, one live model. Standardised output across teams,
          cities and projects — with automated BOQ and BOM so the numbers match
          the drawing.
        </p>

        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            [
              'Automated BOQ and BOM generation',
              'Faster client approvals',
              'Fewer revisions, less confusion',
              'Standardised output across teams',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-white/80">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                {item}
              </li>
            ))
          }
        </ul>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/enterprise/" class="btn-primary">Explore enterprise</a>
          <a
            href="/contact/"
            class="btn border border-white/25 text-white hover:bg-white/10"
            >Book a demo</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ── Referral teaser ─────────────────────────────────────────────────── -->
  <section class="pb-section">
    <div class="shell">
      <div
        class="flex flex-col items-start justify-between gap-6 rounded-card border border-line bg-accent-soft p-8 sm:flex-row sm:items-center"
      >
        <div>
          <p class="eyebrow">Referrals</p>
          <h2 class="mt-2 text-xl font-semibold tracking-tight sm:text-2xl">
            Know a practice that would rather send a walkthrough than a PDF?
          </h2>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-soft">
            {
              plans.billingEnabled
                ? 'Earn 10% of every referred subscription, every month, with no cap.'
                : 'Referrals are recorded from today and pay 10% recurring once billing starts. Your code is already waiting in your account.'
            }
          </p>
        </div>
        <a href="/referral/" class="btn-primary shrink-0">Get your code</a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ─────────────────────────────────────────────────────────────── -->
  <section id="faq" class="scroll-mt-24 pb-section">
    <div class="shell max-w-3xl">
      <p class="eyebrow">FAQs</p>
      <h2 class="h2 mt-3">Frequently asked questions</h2>

      <!-- Both islands on this page are `client:visible`: neither is above the
           fold, so a visitor who never scrolls downloads no component JS at
           all. Everything else here is static HTML. -->
      <FaqAccordion client:visible items={faqs} />
    </div>
  </section>
</Base>
